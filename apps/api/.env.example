NODE_ENV=production
PORT=4000
API_BASE_URL=https://your-backend-project.vercel.app
WEB_APP_URL=https://your-frontend-project.vercel.app
CORS_ORIGINS=https://your-frontend-project.vercel.app,*.vercel.app

# PostgreSQL Connection String (Vercel Postgres / Neon / Supabase / Railway)
DATABASE_URL=postgresql://postgres:password@host:5432/permata?sslmode=require

# JWT Secrets (minimum 32 characters each)
ACCESS_TOKEN_SECRET=replace-with-at-least-32-char-secret-here
REFRESH_TOKEN_SECRET=replace-with-at-least-32-char-secret-here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Optional Object Storage (S3 / R2 / Supabase Storage)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# AI Provider (Google Gemini)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

LOG_LEVEL=info
