# Google Gemini API Key (untuk fitur AI Mental Support Companion & Mood + Food Analyzer)
GEMINI_API_KEY=your_gemini_api_key_here

# Opsional: Kosongkan saat deploy 1 proyek dengan Vercel Services karena rute /api/v1 otomatis satu domain.
