{
  "name": "permata-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @permata/api db:generate",
    "db:migrate": "pnpm --filter @permata/api db:migrate",
    "db:deploy": "pnpm --filter @permata/api db:deploy",
    "db:push": "pnpm --filter @permata/api db:push",
    "db:seed": "pnpm --filter @permata/api db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.18.0"
}
