{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ]
    },
    "backend": {
      "root": "apps/api",
      "entrypoint": "src/server.ts",
      "buildCommand": "node scripts/prepare-vercel.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api/docs",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api/docs/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api/docs.json",
      "destination": { "service": "backend" }
    },
    {
      "source": "/health",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
