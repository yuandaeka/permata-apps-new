# ============================================================================
# PERMATA Monorepo - Environment Variables Example
# ============================================================================

# --- Frontend (@permata/web) ---
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_API_URL=http://localhost:4000

# --- Backend (@permata/api) ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres:admin123@localhost:5432/permata

ACCESS_TOKEN_SECRET=replace-with-at-least-32-char-secret-here
REFRESH_TOKEN_SECRET=replace-with-at-least-32-char-secret-here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
LOG_LEVEL=info
